!tools/crawl/extra-ca.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# wrangler / Cloudflare
.wrangler/
.open-next/
.dev.vars
.dev.vars.*

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings
.claude/settings.local.json

# 未掲載大会の探索の作業ファイル（実行ごとに作り直す。#204）
tools/discover/candidates.json
tools/discover/candidates.md
